generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  isAdmin   Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medico     Medico?
  instrutor  Instrutor?
  demands    Demand[]
}

enum DemandStatus {
  RECEIVED
}

enum DemandCategory {
  FOOD
  CLOTHING
  HYGIENE
  HEALTH
  EDUCATION
  SOCIAL_ASSISTANCE
  OTHER
}

enum DemandReturnPreference {
  WHATSAPP
  PHONE_CALL
}

model Demand {
  id          String       @id @default(uuid())
  description String       @db.VarChar(2000)
  status      DemandStatus @default(RECEIVED)
  requesterId String
  requester   User         @relation(fields: [requesterId], references: [id], onDelete: Restrict)
  requestKey  String
  createdAt   DateTime     @default(now())

  phone                 String?                 @db.VarChar(11)
  neighborhood          String?                 @db.VarChar(120)
  returnPreference      DemandReturnPreference?
  category              DemandCategory?
  otherDescription      String?                 @db.VarChar(200)
  urgent                Boolean?
  contactConsentAt      DateTime?
  contactConsentVersion String?
  contactConsentText    String?

  @@unique([requesterId, requestKey])
  @@index([requesterId, createdAt, id])
  @@index([createdAt, id])
}

model Medico {
  id     String @id @default(uuid())
  userId String @unique

  user   User @relation(fields: [userId], references: [id])

  consultas Consulta[]
}

model Instrutor {
  id     String @id @default(uuid())
  userId String @unique

  user   User @relation(fields: [userId], references: [id])

  aulas Aula[]
}

model Beneficiario {
  id        String   @id @default(uuid())
  name      String
  telefone  String?

  createdAt DateTime @default(now())

  consultas  Consulta[]
  matriculas Matricula[]
}

model Consulta {
  id              String   @id @default(uuid())
  dataHora        DateTime

  medicoId        String
  beneficiarioId  String

  medico         Medico       @relation(fields: [medicoId], references: [id])
  beneficiario   Beneficiario @relation(fields: [beneficiarioId], references: [id])

  createdAt DateTime @default(now())

  @@unique([medicoId, dataHora])
  @@index([beneficiarioId])
}

model Aula {
  id           String   @id @default(uuid())
  titulo       String
  modalidade   String
  vagas        Int

  instrutorId  String
  instrutor    Instrutor @relation(fields: [instrutorId], references: [id])

  matriculas   Matricula[]

  createdAt DateTime @default(now())

  @@index([instrutorId])
}

model Matricula {
  id              String @id @default(uuid())

  beneficiarioId  String
  aulaId          String

  beneficiario Beneficiario @relation(fields: [beneficiarioId], references: [id])
  aula         Aula         @relation(fields: [aulaId], references: [id])

  createdAt DateTime @default(now())

  @@unique([beneficiarioId, aulaId])
  @@index([aulaId])
}
